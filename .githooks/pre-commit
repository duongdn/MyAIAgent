#!/bin/bash
# Pre-commit hook: block hardcoded secrets from being committed
# Scans staged diff for common secret patterns (Slack tokens, passwords, etc.)

PATTERNS=(
  'xoxp-[0-9]'
  'xoxc-[0-9]'
  'xoxb-[0-9]'
  'xoxd-[0-9a-zA-Z]'
  '"password":\s*"[^"]+'
  "'password':\s*'[^']+"
  'password.*=.*"[A-Za-z0-9]{8,}'
)

# Skip vendored / documentation paths — these contain example credentials, schemas, etc.
SKIP_PATHS='^(\.claude/skills/|\.claude/agents/|\.claude/hooks/docs/|docs/memory/|reports/|plans/|node_modules/)'

# Lines matching these are OK (regex patterns, encrypted files, CSS selectors, etc.)
ALLOW='(re\.search|startswith|regex|pattern|example|\.enc|\.gitignore|config/\.|MEMORY|memory|input\[type=|input\[name=|querySelector|pwField|passSel)'

found=0
# Iterate per file so we can skip vendored paths
for file in $(git diff --cached --name-only --diff-filter=ACMR); do
  if echo "$file" | grep -qE "$SKIP_PATHS"; then
    continue
  fi
  diff=$(git diff --cached -U0 --diff-filter=ACMR -- "$file" | grep -E "^\+" | grep -v "^+++" | grep -vE "$ALLOW")
  for pat in "${PATTERNS[@]}"; do
    matches=$(echo "$diff" | grep -E "$pat" 2>/dev/null)
    if [ -n "$matches" ]; then
      if [ $found -eq 0 ]; then
        echo "❌ COMMIT BLOCKED: Hardcoded secrets detected!"
        echo ""
        echo "Load secrets from config/*.json files instead."
        echo ""
      fi
      echo "File: $file"
      echo "Pattern: $pat"
      echo "$matches" | head -3
      echo ""
      found=1
    fi
  done
done

if [ $found -eq 1 ]; then
  echo "Fix: Move secrets to gitignored config files"
  echo "  Slack: config/.slack-accounts.json"
  echo "  Email: config/.email-accounts.json"
  exit 1
fi

# === Daily Report Mandatory Section Check ===
# Block commit if daily-report.md is staged but missing Maddy section
REPORT_FILE=$(echo "$(git diff --cached --name-only --diff-filter=ACMR)" | grep -E '^reports/[0-9]{4}-[0-9]{2}-[0-9]{2}/daily-report\.md$')
if [ -n "$REPORT_FILE" ]; then
  MANDATORY=("## Email" "## Slack" "## Discord" "## Sheets/Workstream" "## Fountain" "## Elena" "## Matrix" "## Maddy" "## Arthur" "## Performance" "## Reminders")
  miss=0
  for sec in "${MANDATORY[@]}"; do
    if ! grep -q "$sec" "$REPORT_FILE"; then
      if [ $miss -eq 0 ]; then
        echo "❌ COMMIT BLOCKED: Daily report missing mandatory sections!"
        echo ""
      fi
      echo "  MISSING: $sec section"
      miss=1
    fi
  done
  if [ $miss -eq 1 ]; then
    echo ""
    echo "All 11 mandatory sections must be present. Add missing sections and re-commit."
    exit 1
  fi
fi

exit 0
